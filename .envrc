# direnv: helper scripts on PATH, pinned tools, and git hooks.
PATH_add .local/bin
watch_file mise.toml lefthook.yml

# AWS CLI on the host -> AWS Emulator published by the devcontainer (compose.yaml).
# The emulator generates its CA and credentials on every start and only accepts
# its own access key, so read both from .local/emulator (bind-mounted).
export AWS_ENDPOINT_URL=https://127.0.0.1:9297
export AWS_REGION=us-west-2
export AWS_DEFAULT_REGION=us-west-2
export AWS_SHARED_CREDENTIALS_FILE="$PWD/.local/emulator/9297/emulator_credentials"
export AWS_CA_BUNDLE="$PWD/.local/emulator/9297/ca.pem"
export AWS_EC2_METADATA_DISABLED=true
export AWS_DISABLE_HOST_PREFIX_INJECTION=true

# Install tools pinned in mise.toml (lefthook) and put them on PATH.
if has mise; then
  mise install --quiet
  eval "$(mise env -s bash)"
fi

# Install/refresh the git hooks defined in lefthook.yml (idempotent).
if has lefthook; then
  if [[ -d .git ]]; then
    lefthook install >/dev/null
  fi
else
  log_error "lefthook not found: install mise (https://mise.jdx.dev) or lefthook, then re-enter the directory"
fi
