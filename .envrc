# direnv: helper scripts on PATH, pinned tools, and git hooks.
PATH_add .local/bin
watch_file mise.toml lefthook.yml

# Install tools pinned in mise.toml (lefthook) and put them on PATH.
if has mise; then
  mise install --quiet
  eval "$(mise env -s bash)"
fi

# Install/refresh the git hooks defined in lefthook.yml (idempotent).
if has lefthook; then
  if [[ -d .git ]]; then
    lefthook install >/dev/null
  fi
else
  log_error "lefthook not found: install mise (https://mise.jdx.dev) or lefthook, then re-enter the directory"
fi
