{
  "name": "React + Java (Podman)",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "runServices": ["app", "db", "db-test", "aws-emulator"],
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "remoteUser": "vscode",
  "updateRemoteUserUID": false,

  // SSH keys/config of the host user who launches the devcontainer.
  // Read-only; userns keep-id maps their files to vscode.
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": "true",
      "installGradle": "true"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers/features/aws-cli:1": {},
    "ghcr.io/duduribeiro/devcontainer-features/neovim:1": {
      "version": "stable" // or "nightly"
    }
  },

  // The emulator generates a new cert on every start, so rebuild the merged
  // trust stores each time the container starts.
  "postStartCommand": "bash .devcontainer/scripts/emulator-trust.sh",

  "forwardPorts": [5173, 8080],
  "portsAttributes": {
    "9297": { "label": "AWS Emulator (HTTPS)" },
    "5173": { "label": "Vite" },
    "8080": { "label": "Java app" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ckolkman.vscode-postgres",
        "amazonwebservices.aws-toolkit-vscode",
        "fwcd.kotlin",
        "Gruntfuggly.todo-tree",
        "ms-vscode.live-server",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "GitHub.vscode-github-actions",
        "GitHub.vscode-pull-request-github"
      ]
    }
  }
}
