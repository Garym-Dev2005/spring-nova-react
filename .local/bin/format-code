#!/usr/bin/env bash
# Format the api/ Kotlin sources (Spotless + ktlint). Also the lefthook pre-commit hook.
#   format-code          apply formatting
#   format-code --check  only report violations (non-zero exit if any)
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../../api"
if [[ "${1:-}" == "--check" ]]; then
  exec ./gradlew spotlessCheck --console=plain -q
fi
exec ./gradlew spotlessApply --console=plain -q
